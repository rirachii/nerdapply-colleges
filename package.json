{
  "name": "nerdapply-colleges",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:import": "python3 scripts/import_scorecard.py",
    "pdf:sample": "tsx scripts/sample-pdf.tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts tests index.html vite.config.ts package.json tsconfig.json",
    "format:check": "prettier --check src scripts tests index.html vite.config.ts package.json tsconfig.json",
    "pdf:verify": "python3 scripts/verify_pdfs.py",
    "pdf:stress": "tsx scripts/stress-pdf.tsx",
    "deploy:prepare": "npm run build && node scripts/prepare-vercel.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@react-pdf/renderer": "^4.9.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
